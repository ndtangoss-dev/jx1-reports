 void KNpcAttribModify::special_point(KNpc* pNpc, void* pData)
 {
+#ifdef _SERVER
+	// [qh Q-90] Diem tai phu: cong/tru gia tri vao nhan vat (Apply = +M, Remove = -M)
+	if (!pNpc || !pData) return;
+	int nPl = pNpc->GetPlayerIdx();
+	if (nPl <= 0 || nPl >= MAX_PLAYER) return;
+	KMagicAttrib* pAttr = (KMagicAttrib*)pData;
+	Player[nPl].m_nWealth += pAttr->nValue[0];
+	if (Player[nPl].m_nWealth < 0) Player[nPl].m_nWealth = 0;
+#endif
 
 }

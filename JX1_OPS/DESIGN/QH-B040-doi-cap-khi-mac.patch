 	return FALSE;
 }
 
+// [qh Q-92] Doi cap cuong hoa: neu mon dang mac thi thao dong thuoc tinh cu khoi nhan vat, tinh lai, ap dong moi (gom ca tai phu / +14 ky nang)
+void KItemList::QhSetEnChance(int nIdx, int nLevel)
+{
+	if (nIdx <= 0 || nIdx >= MAX_ITEM)
+		return;
+	int i = itempart_num;
+	if (m_PlayerIdx > 0)
+		for (i = 0; i < itempart_num; ++i)
+			if (m_EquipItem[i] == nIdx) break;
+	BOOL bWorn = (m_PlayerIdx > 0 && i < itempart_num && Item[nIdx].GetIsCanUse() == 1);
+	int nNpcIdx = bWorn ? Player[m_PlayerIdx].m_nIndex : 0;
+	int nActive = 0;
+	int nInfo[2] = {0, 0};
+	if (bWorn)
+	{
+		nActive = GetEquipEnhance(i);
+		if (m_bActiveSet) nActive = 3;
+		if (Item[nIdx].GetGoldId() > 0) { nInfo[0] = 3; nInfo[1] = Item[nIdx].GetLevel(); }
+		Item[nIdx].RemoveMagicAttribFromNPC(&Npc[nNpcIdx], nActive, nInfo);
+	}
+	Item[nIdx].EnChance(nLevel);
+	if (bWorn)
+	{
+		nInfo[0] = 0; nInfo[1] = 0;
+		if (Item[nIdx].IsBlue()) { nInfo[0] = 1; nInfo[1] = Item[nIdx].GetIsWhere(); }
+		else if (Item[nIdx].IsPurple()) { nInfo[0] = 2; nInfo[1] = Item[nIdx].GetIsWhere(); }
+		else if (Item[nIdx].IsGold()) { nInfo[0] = 3; nInfo[1] = Item[nIdx].GetLevel(); }
+		Item[nIdx].ApplyMagicAttribToNPC(&Npc[nNpcIdx], nActive, nInfo);
+	}
+}

+// [qh B-035] Ba ham Lua phuc vu cuong hoa. GetEquipIdx(part): idx item dang mac (0 neu trong). CountBagItemExact(ten): dem trong tui (khong tinh do dang mac), khop CHINH XAC ten. ConsumeBagItemExact(ten, n): tru n cai trong tui, tra 1 neu du va da tru.
+int LuaGetEquipIdx(Lua_State *L)
+{
+	int nPlayerIndex = GetPlayerIndex(L);
+	int nPart = (int)Lua_ValueToNumber(L,1);
+	if (nPlayerIndex <= 0 || nPart < 0 || nPart >= itempart_num)
+	{
+		Lua_PushNumber(L, 0);
+		return 1;
+	}
+	Lua_PushNumber(L, Player[nPlayerIndex].m_ItemList.GetEquipment(nPart));
+	return 1;
+}
+
+int LuaCountBagItemExact(Lua_State *L)
+{
+	int nPlayerIndex = GetPlayerIndex(L);
+	const char* szName = Lua_ValueToString(L,1);
+	if (nPlayerIndex <= 0 || !szName)
+	{
+		Lua_PushNumber(L, 0);
+		return 1;
+	}
+	Lua_PushNumber(L, Player[nPlayerIndex].m_ItemList.QhCountExact(szName));
+	return 1;
+}
+
+int LuaConsumeBagItemExact(Lua_State *L)
+{
+	int nPlayerIndex = GetPlayerIndex(L);
+	const char* szName = Lua_ValueToString(L,1);
+	int nNeed = (int)Lua_ValueToNumber(L,2);
+	if (nPlayerIndex <= 0 || !szName || nNeed <= 0)
+	{
+		Lua_PushNumber(L, 0);
+		return 1;
+	}
+	Lua_PushNumber(L, Player[nPlayerIndex].m_ItemList.QhConsumeExact(szName, nNeed));
+	return 1;
+}

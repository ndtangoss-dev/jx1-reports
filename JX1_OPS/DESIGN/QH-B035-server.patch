+// [qh B-035] Nguyen lieu cuong hoa: khop CHINH XAC ten, chi trong tui (khong tinh do dang mac).
+int KItemList::QhCountExact(const char* szName)
+{
+	int nIdx = 0, nCount = 0;
+	if (!szName)
+		return 0;
+	while ((nIdx = m_UseIdxItemList.GetNext(nIdx)))
+	{
+		int nItem = m_Items[nIdx].nIdx;
+		if (nItem <= 0 || nItem >= MAX_ITEM || m_Items[nIdx].nPlace == pos_equip)
+			continue;
+		if (strcmp(Item[nItem].GetName(), szName) == 0)
+			nCount += (Item[nItem].GetStackNum() > 0 ? Item[nItem].GetStackNum() : 1);
+	}
+	return nCount;
+}
+
+int KItemList::QhConsumeExact(const char* szName, int nNeed)
+{
+	if (!szName || nNeed <= 0 || QhCountExact(szName) < nNeed)
+		return 0;
+	int nIdx = 0;
+	while (nNeed > 0 && (nIdx = m_UseIdxItemList.GetNext(nIdx)))
+	{
+		int nItem = m_Items[nIdx].nIdx;
+		if (nItem <= 0 || nItem >= MAX_ITEM || m_Items[nIdx].nPlace == pos_equip)
+			continue;
+		if (strcmp(Item[nItem].GetName(), szName) != 0)
+			continue;
+		int nStack = (Item[nItem].GetStackNum() > 0 ? Item[nItem].GetStackNum() : 1);
+		if (nStack > nNeed)
+		{
+			Item[nItem].SetStackNum(nStack - nNeed);
+			SynPlayerItem(nItem);
+			nNeed = 0;
+		}
+		else
+		{
+			nNeed -= nStack;
+			Remove(nItem);
+			ItemSet.Remove(nItem);
+			nIdx = 0; // danh sach doi sau khi xoa: duyet lai tu dau
+		}
+	}
+	return nNeed == 0 ? 1 : 0;
+}
